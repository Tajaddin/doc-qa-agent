# Copy to .env and fill in. Never commit .env.

# ----- Anthropic -----
ANTHROPIC_API_KEY=
# Model used for the main /ask answer with citations.
ANSWER_MODEL=claude-sonnet-4-6
# Cheap model used for LLM-as-judge grading in eval.
JUDGE_MODEL=claude-haiku-4-5
# Extra models a POST /ask client may request in "model", comma-separated.
# ANSWER_MODEL is always allowed; any other model gets 400 model_not_allowed.
ALLOWED_MODELS=

# ----- Embeddings -----
# Provider selection. Empty means auto-detect (prefer voyage if its key is set).
# Force one explicitly when both keys are present, e.g. EMBEDDING_PROVIDER=openai.
EMBEDDING_PROVIDER=

# Primary: Voyage AI. voyage-3-large outputs 1024-dim vectors by default.
# Free tier without billing is throttled to 3 RPM / 10K TPM. Add a payment
# method at dashboard.voyageai.com to unlock standard limits.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-large

# Fallback: OpenAI. The dimensions parameter shortens text-embedding-3-* to 1024
# so the same chunks table column works without alteration.
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIMENSIONS=1024

# Logical dim used everywhere. Must match the vector(N) column in sql/001_init.sql.
EMBEDDING_DIM=1024

# ----- Database -----
# Local Docker (docker compose up -d): postgresql://docqa:docqa@localhost:5432/docqa
# Supabase direct: postgresql://postgres:<PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres
# Supabase pooler (transaction mode):
#   postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://docqa:docqa@localhost:5432/docqa

# ----- Crawler -----
# Anthropic docs are served from platform.claude.com. The sitemap lives at
# docs.anthropic.com/sitemap.xml and lists the platform.claude.com canonical URLs.
CRAWL_BASE_URL=https://platform.claude.com
CRAWL_SITEMAP_URL=https://docs.anthropic.com/sitemap.xml
CRAWL_MAX_PAGES=150
# Path filter keeps the crawler inside the English docs subtree.
CRAWL_PATH_ALLOW=/docs/en/
# Deny list excludes API endpoint reference pages (auto-generated, low signal
# for natural-language Q&A, and they outrank conceptual docs on keyword
# overlap). Conceptual API guidance lives at /docs/en/build-with-claude/ and
# stays in the corpus. Comma-separated. Applied after allow.
CRAWL_PATH_DENY=/docs/en/api/

# ----- API -----
API_HOST=127.0.0.1
API_PORT=8000

# ----- Retrieval -----
RETRIEVE_CANDIDATES=20
RETRIEVE_FINAL_K=5
